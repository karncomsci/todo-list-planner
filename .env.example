# Copy to .env and fill in. Docker Compose reads .env from this folder.

# PostgreSQL. Use letters, digits, - and _ in the password: it is placed in a connection URL.
POSTGRES_USER=planner
POSTGRES_PASSWORD=change-me
POSTGRES_DB=planner
# Host port for the database, used by the API test suite.
DB_HOST_PORT=5433

# Port for the app in the browser: http://localhost:3000, or http://<this machine's IP>:3000 from a phone.
WEB_PORT=3000

# Initial Owner, created on first run only when no Owner exists (D16).
# Later changes here are ignored: the stored account is never overwritten.
# The password needs at least 8 characters.
OWNER_EMAIL=
OWNER_PASSWORD=

# Set to true once the app is served over HTTPS, so the session cookie is sent only over HTTPS.
COOKIE_SECURE=false
