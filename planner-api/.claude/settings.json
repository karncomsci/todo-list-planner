{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(go test *)",
      "Bash(TEST_DATABASE_URL=* go test *)",
      "Bash(go vet *)",
      "Bash(go build *)",
      "Bash(gofmt *)",
      "Bash(MSYS_NO_PATHCONV=1 docker run --rm -v * -w /src sqlc/sqlc:1.31.1 generate)",
      "Bash(docker compose up -d db)",
      "Bash(docker compose up -d --build api)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "Bash(curl http://127.0.0.1:8080/api/*)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Bash(git commit *)",
      "Bash(git push *)"
    ]
  }
}
