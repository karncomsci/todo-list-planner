{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run dev)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm test *)",
      "Bash(npm test)",
      "Bash(npm run build)",
      "Bash(docker compose up -d api)",
      "Bash(docker compose up -d --build)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Bash(git commit *)",
      "Bash(git push *)"
    ]
  }
}
